{
  "openapi": "3.1.0",
  "info": {
    "title": "Nahuali Beta API",
    "version": "0.1.0",
    "description": "HTTP surface over nahuali-core. The SurrealDB memory_record ledger remains authoritative, SurrealDB graph tables are derived projections, and Qdrant is a rebuildable semantic index."
  },
  "paths": {
    "/v1/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Return memory counts, authority, health, and graph projection validation.",
        "responses": {
          "200": { "$ref": "#/components/responses/StatusResponse" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenapi",
        "summary": "Return the static OpenAPI contract for the beta HTTP surface.",
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/episode": {
      "post": {
        "operationId": "createEpisode",
        "summary": "Append an observed episode through nahuali-core.",
        "requestBody": { "$ref": "#/components/requestBodies/EpisodeRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/claim": {
      "post": {
        "operationId": "createClaim",
        "summary": "Append a derived claim through nahuali-core.",
        "requestBody": { "$ref": "#/components/requestBodies/ClaimRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/link": {
      "post": {
        "operationId": "createLink",
        "summary": "Append a derived typed link through nahuali-core.",
        "requestBody": { "$ref": "#/components/requestBodies/LinkRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/procedure": {
      "post": {
        "operationId": "createProcedure",
        "summary": "Append a reusable procedure through nahuali-core.",
        "requestBody": { "$ref": "#/components/requestBodies/ProcedureRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/intention": {
      "post": {
        "operationId": "createIntention",
        "summary": "Append future work, a goal, or a reminder through nahuali-core.",
        "requestBody": { "$ref": "#/components/requestBodies/IntentionRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/intention/update": {
      "post": {
        "operationId": "updateIntention",
        "summary": "Update intention metadata without changing lifecycle status.",
        "requestBody": { "$ref": "#/components/requestBodies/IntentionUpdateRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/intention/status": {
      "post": {
        "operationId": "updateIntentionStatus",
        "summary": "Change an intention lifecycle state.",
        "requestBody": { "$ref": "#/components/requestBodies/IntentionStatusRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/intention/reconcile": {
      "post": {
        "operationId": "reconcileIntentions",
        "summary": "Return a non-mutating intention reconciliation report.",
        "requestBody": { "$ref": "#/components/requestBodies/IntentionReconcileRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/goal-progress": {
      "get": {
        "operationId": "getGoalProgress",
        "summary": "Return a non-mutating goal progress report.",
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/proactive": {
      "post": {
        "operationId": "getProactiveReport",
        "summary": "Return a non-mutating proactive operator report.",
        "requestBody": { "$ref": "#/components/requestBodies/ProactiveRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/deadlines": {
      "post": {
        "operationId": "getDeadlines",
        "summary": "Return non-mutating proactive deadline signals.",
        "requestBody": { "$ref": "#/components/requestBodies/ProactiveRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/anomalies": {
      "post": {
        "operationId": "getAnomalies",
        "summary": "Return non-mutating proactive anomaly alerts.",
        "requestBody": { "$ref": "#/components/requestBodies/ProactiveRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/anomaly/acknowledge": {
      "post": {
        "operationId": "acknowledgeAnomaly",
        "summary": "Acknowledge a proactive anomaly with an explicit audit note.",
        "requestBody": { "$ref": "#/components/requestBodies/AnomalyAcknowledgeRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/recall": {
      "post": {
        "operationId": "recall",
        "summary": "Recall projected memory with authority and health context.",
        "requestBody": { "$ref": "#/components/requestBodies/RecallRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/RecallResponse" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/session-resume": {
      "post": {
        "operationId": "sessionResume",
        "summary": "Return a continuity briefing with authority and health context.",
        "requestBody": { "$ref": "#/components/requestBodies/SessionResumeRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/SessionResumeResponse" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/memory-health": {
      "post": {
        "operationId": "getMemoryHealth",
        "summary": "Return knowledge-health and authority context.",
        "requestBody": { "$ref": "#/components/requestBodies/EmptyRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/MemoryHealthResponse" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/audit": {
      "get": {
        "operationId": "getAudit",
        "summary": "Diff what the record ledger recorded between two points.",
        "parameters": [
          { "$ref": "#/components/parameters/AuditFrom" },
          { "$ref": "#/components/parameters/AuditTo" },
          { "$ref": "#/components/parameters/AuditSince" },
          { "$ref": "#/components/parameters/AuditUntil" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/trust-report": {
      "get": {
        "operationId": "getTrustReport",
        "summary": "Return a composed memory trust report.",
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/graph": {
      "get": {
        "operationId": "getGraph",
        "summary": "Return a deterministic graph neighborhood.",
        "parameters": [
          { "$ref": "#/components/parameters/GraphSeed" },
          { "$ref": "#/components/parameters/Depth" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/timeline": {
      "get": {
        "operationId": "getTimeline",
        "summary": "Return SurrealDB graph-projection episodes.",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/pending": {
      "get": {
        "operationId": "getPending",
        "summary": "Return SurrealDB graph-projection pending intentions.",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/projection/status": {
      "get": {
        "operationId": "getProjectionStatus",
        "summary": "Return SurrealDB graph-projection checkpoint and table counts.",
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/projection/rebuild": {
      "post": {
        "operationId": "rebuildProjection",
        "summary": "Rebuild derived SurrealDB graph projection from the record ledger.",
        "requestBody": { "$ref": "#/components/requestBodies/EmptyRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/projection/validate": {
      "post": {
        "operationId": "validateProjection",
        "summary": "Validate derived SurrealDB graph projection against the record ledger.",
        "requestBody": { "$ref": "#/components/requestBodies/EmptyRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/semantic/status": {
      "get": {
        "operationId": "getSemanticStatus",
        "summary": "Return Qdrant semantic-index status.",
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/semantic/rebuild": {
      "post": {
        "operationId": "rebuildSemantic",
        "summary": "Rebuild Qdrant semantic index from the projected memory state.",
        "requestBody": { "$ref": "#/components/requestBodies/EmptyRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/v1/review/resolve": {
      "post": {
        "operationId": "resolveReview",
        "summary": "Append an explicit operator review resolution.",
        "requestBody": { "$ref": "#/components/requestBodies/ReviewResolveRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "AuditFrom": {
        "name": "from",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0 },
        "description": "Exclusive lower sequence bound. Defaults to the genesis event."
      },
      "AuditTo": {
        "name": "to",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0 },
        "description": "Inclusive upper sequence bound. Defaults to the latest event."
      },
      "AuditSince": {
        "name": "since",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0 },
        "description": "Inclusive lower timestamp bound in milliseconds since the Unix epoch."
      },
      "AuditUntil": {
        "name": "until",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0 },
        "description": "Inclusive upper timestamp bound in milliseconds since the Unix epoch."
      },
      "Depth": {
        "name": "depth",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0 },
        "description": "Graph traversal depth. Defaults to 2."
      },
      "GraphSeed": {
        "name": "seed",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "minLength": 1 },
        "description": "Canonical entity or memory id used as the graph seed."
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1 },
        "description": "Maximum number of records to return."
      }
    },
    "requestBodies": {
      "AnomalyAcknowledgeRequest": { "$ref": "#/components/requestBodies/JsonAnomalyAcknowledgeRequest" },
      "ClaimRequest": { "$ref": "#/components/requestBodies/JsonClaimRequest" },
      "EmptyRequest": { "$ref": "#/components/requestBodies/JsonEmptyRequest" },
      "EpisodeRequest": { "$ref": "#/components/requestBodies/JsonEpisodeRequest" },
      "IntentionReconcileRequest": { "$ref": "#/components/requestBodies/JsonIntentionReconcileRequest" },
      "IntentionRequest": { "$ref": "#/components/requestBodies/JsonIntentionRequest" },
      "IntentionStatusRequest": { "$ref": "#/components/requestBodies/JsonIntentionStatusRequest" },
      "IntentionUpdateRequest": { "$ref": "#/components/requestBodies/JsonIntentionUpdateRequest" },
      "LinkRequest": { "$ref": "#/components/requestBodies/JsonLinkRequest" },
      "ProcedureRequest": { "$ref": "#/components/requestBodies/JsonProcedureRequest" },
      "ProactiveRequest": { "$ref": "#/components/requestBodies/JsonProactiveRequest" },
      "RecallRequest": { "$ref": "#/components/requestBodies/JsonRecallRequest" },
      "ReviewResolveRequest": { "$ref": "#/components/requestBodies/JsonReviewResolveRequest" },
      "SessionResumeRequest": { "$ref": "#/components/requestBodies/JsonSessionResumeRequest" },
      "JsonAnomalyAcknowledgeRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnomalyAcknowledgeRequest" } } }
      },
      "JsonClaimRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClaimRequest" } } }
      },
      "JsonEmptyRequest": {
        "required": false,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmptyRequest" } } }
      },
      "JsonEpisodeRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EpisodeRequest" } } }
      },
      "JsonIntentionReconcileRequest": {
        "required": false,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IntentionReconcileRequest" } } }
      },
      "JsonIntentionRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IntentionRequest" } } }
      },
      "JsonIntentionStatusRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IntentionStatusRequest" } } }
      },
      "JsonIntentionUpdateRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IntentionUpdateRequest" } } }
      },
      "JsonLinkRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LinkRequest" } } }
      },
      "JsonProcedureRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProcedureRequest" } } }
      },
      "JsonProactiveRequest": {
        "required": false,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProactiveRequest" } } }
      },
      "JsonRecallRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecallRequest" } } }
      },
      "JsonReviewResolveRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewResolveRequest" } } }
      },
      "JsonSessionResumeRequest": {
        "required": false,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionResumeRequest" } } }
      }
    },
    "responses": {
      "ApiError": {
        "description": "Structured Nahuali API error.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } } }
      },
      "StatusResponse": {
        "description": "Memory counts, store-level authority, knowledge health, and graph projection validation.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StatusResponse" } } }
      },
      "RecallResponse": {
        "description": "Lexical recall results with per-result trust, store-level authority, and knowledge health.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecallResponse" } } }
      },
      "MemoryHealthResponse": {
        "description": "Store-level authority decision paired with the knowledge-health report it was derived from.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MemoryHealthResponse" } } }
      },
      "SessionResumeResponse": {
        "description": "Continuity briefing with store-level authority and knowledge-health context.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionResumeResponse" } } }
      },
      "JsonObject": {
        "description": "JSON response returned by nahuali-core.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JsonObject" } } }
      }
    },
    "schemas": {
      "AnomalyAcknowledgeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anomaly_id", "note"],
        "properties": {
          "anomaly_id": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 },
          "dry_run": { "type": "boolean", "default": false }
        }
      },
      "ApiErrorBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ApiErrorBody" }
        }
      },
      "ClaimRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "predicate", "object"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "object": { "type": "string", "minLength": 1 },
          "source_episode_id": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
          "scope": { "$ref": "#/components/schemas/MemoryScope" }
        }
      },
      "EmptyRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "EpisodeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content"],
        "properties": {
          "content": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
          "mentions": { "type": "array", "items": { "type": "string" }, "default": [] },
          "scope": { "$ref": "#/components/schemas/MemoryScope" }
        }
      },
      "IntentionKind": {
        "type": "string",
        "enum": ["task", "goal", "reminder"]
      },
      "IntentionPriority": {
        "type": "string",
        "enum": ["low", "medium", "high", "critical"]
      },
      "IntentionReconcileRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "now_ms": { "type": "integer", "minimum": 0 },
          "stale_after_ms": { "type": "integer", "minimum": 0 }
        }
      },
      "IntentionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "kind", "priority"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "kind": { "$ref": "#/components/schemas/IntentionKind" },
          "priority": { "$ref": "#/components/schemas/IntentionPriority" },
          "source_episode_id": { "type": "string" },
          "scope": { "$ref": "#/components/schemas/MemoryScope" }
        }
      },
      "IntentionStatus": {
        "type": "string",
        "enum": ["active", "completed", "abandoned", "blocked", "deferred"]
      },
      "IntentionStatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/components/schemas/IntentionStatus" },
          "reason": { "type": "string" }
        }
      },
      "IntentionUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "priority": { "$ref": "#/components/schemas/IntentionPriority" },
          "deadline_at_ms": { "type": ["integer", "null"], "minimum": 0 },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "goal_id": { "type": ["string", "null"] },
          "progress_percent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
        }
      },
      "JsonObject": {
        "type": "object",
        "additionalProperties": true
      },
      "LinkRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "relation", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "source_episode_id": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
          "scope": { "$ref": "#/components/schemas/MemoryScope" }
        }
      },
      "MemoryKind": {
        "type": "string",
        "enum": ["entity", "episode", "claim", "link", "procedure", "intention", "fact", "relation"]
      },
      "MemoryScope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name"],
        "properties": {
          "kind": { "type": "string", "enum": ["personal", "project", "organization", "custom"] },
          "name": { "type": "string", "minLength": 1 }
        }
      },
      "ProcedureRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "body"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "source_episode_id": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
          "scope": { "$ref": "#/components/schemas/MemoryScope" }
        }
      },
      "ProactiveRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "now_ms": { "type": "integer", "minimum": 0 },
          "deadline_horizon_ms": { "type": "integer", "minimum": 0 },
          "stale_after_ms": { "type": "integer", "minimum": 0 },
          "review_limit": { "type": "integer", "minimum": 1 }
        }
      },
      "RecallRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "limit": { "type": "integer", "minimum": 1, "default": 10 },
          "scope": { "$ref": "#/components/schemas/MemoryScope" },
          "kinds": { "type": "array", "items": { "$ref": "#/components/schemas/MemoryKind" }, "default": [] },
          "require_evidence": { "type": "boolean", "default": false },
          "semantic": { "type": "boolean", "default": false }
        }
      },
      "ReviewResolveRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_id", "note"],
        "properties": {
          "review_id": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 },
          "dry_run": { "type": "boolean", "default": false }
        }
      },
      "SessionResumeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "episode_limit": { "type": "integer", "minimum": 1, "default": 5 },
          "intention_limit": { "type": "integer", "minimum": 1, "default": 5 },
          "review_limit": { "type": "integer", "minimum": 1, "default": 5 },
          "graph_seed_limit": { "type": "integer", "minimum": 1, "default": 8 }
        }
      },
      "AuthorityMode": {
        "type": "string",
        "description": "Authority mode assigned to a memory answer, derived deterministically from knowledge health.",
        "enum": ["advisory", "warn", "block", "certify"]
      },
      "AuthorityDecision": {
        "type": "object",
        "description": "Deterministic store-level trust decision derived from knowledge health.",
        "additionalProperties": false,
        "required": ["mode", "score", "can_trust", "reasons", "signal_kinds"],
        "properties": {
          "mode": { "$ref": "#/components/schemas/AuthorityMode" },
          "score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Numeric trust score in the 0.0..=1.0 range." },
          "can_trust": { "type": "boolean", "description": "Whether callers may rely on memory without adding uncertainty." },
          "reasons": { "type": "array", "items": { "type": "string" }, "description": "Human-readable reasons for the decision." },
          "signal_kinds": { "type": "array", "items": { "$ref": "#/components/schemas/HealthSignalKind" }, "description": "Health signal kinds that drove the decision." }
        }
      },
      "RecallResultTrustMode": {
        "type": "string",
        "description": "Query-local trust classification for one recall result.",
        "enum": ["certify", "advisory", "warn", "block"]
      },
      "RecallResultTrust": {
        "type": "object",
        "description": "Query-local trust context for one recall result, independent of store-level authority.",
        "additionalProperties": false,
        "required": ["mode", "score", "can_trust", "reasons", "signal_kinds"],
        "properties": {
          "mode": { "$ref": "#/components/schemas/RecallResultTrustMode" },
          "score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Numeric result trust score in the 0.0..=1.0 range." },
          "can_trust": { "type": "boolean", "description": "Whether callers may rely on this specific result without adding uncertainty." },
          "reasons": { "type": "array", "items": { "type": "string" }, "description": "Human-readable reasons for this result trust decision." },
          "signal_kinds": { "type": "array", "items": { "type": "string" }, "description": "Result-local health signal kinds that drove the decision." }
        }
      },
      "HealthSignalKind": {
        "type": "string",
        "description": "Category for a knowledge-health signal.",
        "enum": ["no_episodes", "unsupported_fact", "low_confidence_fact", "conflicting_fact", "stale_fact", "isolated_entity"]
      },
      "HealthDimension": {
        "type": "string",
        "description": "Higher-level knowledge-health dimension affected by a signal.",
        "enum": ["completeness", "confidence", "freshness", "connectivity", "contradiction", "staleness", "unsupported_memory", "blind_spot"]
      },
      "HealthSeverity": {
        "type": "string",
        "description": "Severity level for a knowledge-health signal.",
        "enum": ["high", "medium", "low"]
      },
      "HealthSignal": {
        "type": "object",
        "description": "Single knowledge-health issue or observation.",
        "additionalProperties": false,
        "required": ["kind", "dimensions", "severity", "message", "evidence_ids"],
        "properties": {
          "kind": { "$ref": "#/components/schemas/HealthSignalKind" },
          "dimensions": { "type": "array", "items": { "$ref": "#/components/schemas/HealthDimension" } },
          "severity": { "$ref": "#/components/schemas/HealthSeverity" },
          "message": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" }, "description": "Event or memory identifiers that support the signal." }
        }
      },
      "KnowledgeHealth": {
        "type": "object",
        "description": "Structured health report for a projected memory store.",
        "additionalProperties": false,
        "required": [
          "event_count", "episode_count", "fact_count", "relation_count", "entity_count",
          "supported_fact_count", "unsupported_fact_count", "low_confidence_fact_count",
          "conflicting_fact_count", "stale_fact_count", "isolated_entity_count", "blind_spot_count",
          "average_fact_confidence", "signals", "warnings"
        ],
        "properties": {
          "event_count": { "type": "integer", "minimum": 0 },
          "episode_count": { "type": "integer", "minimum": 0 },
          "fact_count": { "type": "integer", "minimum": 0 },
          "relation_count": { "type": "integer", "minimum": 0 },
          "entity_count": { "type": "integer", "minimum": 0 },
          "supported_fact_count": { "type": "integer", "minimum": 0 },
          "unsupported_fact_count": { "type": "integer", "minimum": 0 },
          "low_confidence_fact_count": { "type": "integer", "minimum": 0 },
          "conflicting_fact_count": { "type": "integer", "minimum": 0 },
          "stale_fact_count": { "type": "integer", "minimum": 0 },
          "isolated_entity_count": { "type": "integer", "minimum": 0 },
          "blind_spot_count": { "type": "integer", "minimum": 0 },
          "average_fact_confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Mean confidence for projected facts, rounded to two decimals." },
          "signals": { "type": "array", "items": { "$ref": "#/components/schemas/HealthSignal" } },
          "warnings": { "type": "array", "items": { "type": "string" }, "description": "Human-readable warning messages derived from the signals." }
        }
      },
      "RecallResult": {
        "type": "object",
        "description": "Scored lexical recall candidate.",
        "additionalProperties": false,
        "required": ["kind", "id", "score", "excerpt", "matched_terms"],
        "properties": {
          "kind": { "$ref": "#/components/schemas/MemoryKind" },
          "id": { "type": "string", "description": "Identifier of the matched memory item." },
          "score": { "type": "number", "description": "Deterministic lexical score, including confidence and evidence bonuses." },
          "excerpt": { "type": "string", "description": "Human-readable excerpt for display or agent context." },
          "evidence_id": { "type": ["string", "null"], "description": "Optional evidence episode identifier." },
          "matched_terms": { "type": "array", "items": { "type": "string" }, "description": "Normalized query terms found in the matched item." },
          "scope": { "$ref": "#/components/schemas/MemoryScope" },
          "trust": { "$ref": "#/components/schemas/RecallResultTrust" }
        }
      },
      "GraphProjectionStatus": {
        "type": "object",
        "description": "SurrealDB graph-projection checkpoint and table counts.",
        "additionalProperties": false,
        "required": ["projection_version", "ledger_event_count", "table_counts", "in_sync"],
        "properties": {
          "projection_version": { "type": "integer", "minimum": 0 },
          "ledger_event_count": { "type": "integer", "minimum": 0 },
          "latest_sequence": { "type": ["integer", "null"], "minimum": 0 },
          "latest_event_id": { "type": ["string", "null"] },
          "checkpoint_sequence": { "type": ["integer", "null"], "minimum": 0 },
          "checkpoint_event_id": { "type": ["string", "null"] },
          "table_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "description": "Row count for every graph projection table." },
          "in_sync": { "type": "boolean", "description": "Whether table counts and checkpoint match the current ledger projection." }
        }
      },
      "GraphProjectionValidation": {
        "type": "object",
        "description": "Result of validating the derived graph projection against the record ledger.",
        "additionalProperties": false,
        "required": ["status", "valid", "issues"],
        "properties": {
          "status": { "$ref": "#/components/schemas/GraphProjectionStatus" },
          "valid": { "type": "boolean", "description": "Whether the graph projection matches the current ledger projection." },
          "issues": { "type": "array", "items": { "type": "string" }, "description": "Validation issues. Empty when valid is true." }
        }
      },
      "BriefingSummary": {
        "type": "object",
        "description": "Aggregate counts for a session briefing.",
        "additionalProperties": true,
        "required": ["source_count", "episode_count", "entity_count", "active_intention_count"],
        "properties": {
          "source_count": { "type": "integer", "minimum": 0 },
          "episode_count": { "type": "integer", "minimum": 0 },
          "entity_count": { "type": "integer", "minimum": 0 },
          "active_intention_count": { "type": "integer", "minimum": 0 },
          "high_priority_review_count": { "type": "integer", "minimum": 0 },
          "critical_review_count": { "type": "integer", "minimum": 0 },
          "high_review_count": { "type": "integer", "minimum": 0 }
        }
      },
      "MemoryBriefingReport": {
        "type": "object",
        "description": "Continuity briefing produced by nahuali-core. Collections of recent episodes, active intentions, review items, and graph seeds are returned as structured arrays.",
        "additionalProperties": true,
        "required": ["version", "generated_at_ms", "event_count", "authority", "health", "summary"],
        "properties": {
          "version": { "type": "integer", "minimum": 0 },
          "generated_at_ms": { "type": "integer", "minimum": 0 },
          "event_count": { "type": "integer", "minimum": 0 },
          "authority": { "$ref": "#/components/schemas/AuthorityDecision" },
          "health": { "$ref": "#/components/schemas/KnowledgeHealth" },
          "summary": { "$ref": "#/components/schemas/BriefingSummary" },
          "recent_episodes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "active_intentions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "review_items": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "graph_seeds": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      },
      "StatusResponse": {
        "type": "object",
        "description": "Memory counts, store-level authority, knowledge health, and graph projection validation.",
        "additionalProperties": false,
        "required": [
          "database", "event_count", "source_count", "entity_count", "episode_count",
          "claim_count", "link_count", "procedure_count", "intention_count",
          "review_decision_count", "authority", "health", "surrealdb_graph_projection",
          "semantic_index_role"
        ],
        "properties": {
          "database": { "type": "string", "description": "SurrealDB database name backing this engine." },
          "event_count": { "type": "integer", "minimum": 0 },
          "source_count": { "type": "integer", "minimum": 0 },
          "entity_count": { "type": "integer", "minimum": 0 },
          "episode_count": { "type": "integer", "minimum": 0 },
          "claim_count": { "type": "integer", "minimum": 0 },
          "link_count": { "type": "integer", "minimum": 0 },
          "procedure_count": { "type": "integer", "minimum": 0 },
          "intention_count": { "type": "integer", "minimum": 0 },
          "review_decision_count": { "type": "integer", "minimum": 0 },
          "authority": { "$ref": "#/components/schemas/AuthorityDecision" },
          "health": { "$ref": "#/components/schemas/KnowledgeHealth" },
          "surrealdb_graph_projection": { "$ref": "#/components/schemas/GraphProjectionValidation" },
          "semantic_index_role": { "type": "string", "description": "Role of the Qdrant tier relative to the ledger; always \"derived\"." }
        }
      },
      "RecallResponse": {
        "type": "object",
        "description": "Lexical recall results with per-result trust, store-level authority, and knowledge health. The optional semantic block is present only when the request set semantic=true.",
        "additionalProperties": false,
        "required": ["query", "lexical_results", "authority", "health"],
        "properties": {
          "query": { "type": "string" },
          "lexical_results": { "type": "array", "items": { "$ref": "#/components/schemas/RecallResult" } },
          "authority": { "$ref": "#/components/schemas/AuthorityDecision" },
          "health": { "$ref": "#/components/schemas/KnowledgeHealth" },
          "semantic": { "type": "object", "additionalProperties": true, "description": "Hybrid (lexical + semantic) recall report; omitted unless semantic recall was requested." }
        }
      },
      "MemoryHealthResponse": {
        "type": "object",
        "description": "Store-level authority decision paired with the knowledge-health report it was derived from.",
        "additionalProperties": false,
        "required": ["authority", "health"],
        "properties": {
          "authority": { "$ref": "#/components/schemas/AuthorityDecision" },
          "health": { "$ref": "#/components/schemas/KnowledgeHealth" }
        }
      },
      "SessionResumeResponse": {
        "type": "object",
        "description": "Continuity briefing with store-level authority and knowledge-health context.",
        "additionalProperties": false,
        "required": ["database", "authority", "health", "briefing"],
        "properties": {
          "database": { "type": "string" },
          "authority": { "$ref": "#/components/schemas/AuthorityDecision" },
          "health": { "$ref": "#/components/schemas/KnowledgeHealth" },
          "briefing": { "$ref": "#/components/schemas/MemoryBriefingReport" }
        }
      }
    }
  }
}
