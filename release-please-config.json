{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "separate-pull-requests": false,
  "prerelease": true,
  "prerelease-type": "beta",
  "bootstrap-sha": "b5c29f752261ba9098aa5fe83c98476cdb6372b2",
  "pull-request-title-pattern": "chore(release): release ${component} ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "security", "section": "Security" },
    { "type": "refactor", "section": "Refactor", "hidden": false },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "build", "section": "Build system", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    "crates/nahuali-core": {
      "component": "nahuali-core",
      "package-name": "nahuali-core",
      "skip-github-release": true
    },
    "crates/nahuali-cli": {
      "component": "nahuali-cli",
      "package-name": "nahuali-cli"
    },
    "crates/nahuali-mcp": {
      "component": "nahuali-mcp",
      "package-name": "nahuali-mcp",
      "skip-github-release": true
    },
    "crates/nahuali-api": {
      "component": "nahuali-api",
      "package-name": "nahuali-api",
      "skip-github-release": true
    },
    "crates/nahuali-regression": {
      "component": "nahuali-regression",
      "package-name": "nahuali-regression",
      "skip-github-release": true
    }
  },
  "plugins": [
    { "type": "cargo-workspace", "merge": true }
  ]
}
